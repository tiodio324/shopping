{
  "name": "homelinks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "============== Lint =============": "",
    "lint": "npm run lint:ts && npm run lint:oxlint",
    "lint:oxlint": "oxlint . --fix --type-aware",
    "lint:ts": "npm run lint:ts:node && npm run lint:ts:web",
    "lint:ts:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "lint:ts:web": "tsc --noEmit -p tsconfig.app.json --composite false"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@rolldown/plugin-babel": "^0.3.0",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "^1.0.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2006",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
